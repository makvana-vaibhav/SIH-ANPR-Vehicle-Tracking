# ── Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Fetched artifacts (fetch scripts are committed, payloads are not) ──
data/models/*
!data/models/.gitkeep
!data/models/README.md
data/videos/*
!data/videos/.gitkeep
!data/videos/README.md
data/synthetic/

# ── Container state ───────────────────────────────────────────
.volumes/
infra/minio/data/
infra/postgres/data/
infra/opensearch/data/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# ── Node ──────────────────────────────────────────────────────
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo
npm-debug.log*

# ── Generated contracts (regenerated by `make contracts`) ─────
packages/contracts/generated/**/*.ts
packages/contracts/generated/**/*.py
!packages/contracts/generated/.gitkeep

# ── Benchmark / load output ───────────────────────────────────
tests/load/results/
benchmarks/*.json

# ── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
