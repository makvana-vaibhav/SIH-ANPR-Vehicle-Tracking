ENVIRONMENT=production
COMPOSE_PROJECT_NAME=sentinel-main

# Host-level ports used by nginx upstreams.
WEB_HOST_PORT=28080
API_HOST_PORT=28000
POSTGRES_HOST_PORT=25432
REDIS_HOST_PORT=26379
MINIO_API_HOST_PORT=29000
MINIO_CONSOLE_HOST_PORT=29001
OPENSEARCH_HOST_PORT=29200
MEDIAMTX_RTSP_PORT=28554
MEDIAMTX_HLS_PORT=28888
MEDIAMTX_WEBRTC_PORT=28889
MEDIAMTX_API_PORT=29997
SIMULATOR_HOST_PORT=29100

# Bind every service to localhost; only nginx is internet-facing.
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
POSTGRES_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
MINIO_BIND_ADDRESS=127.0.0.1
OPENSEARCH_BIND_ADDRESS=127.0.0.1
MEDIAMTX_BIND_ADDRESS=127.0.0.1
SIMULATOR_BIND_ADDRESS=127.0.0.1

# Production-grade secrets must be unique per environment.
POSTGRES_PASSWORD=replace_me
MINIO_ROOT_USER=replace_me
MINIO_ROOT_PASSWORD=replace_me
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_me
GRAFANA_ADMIN_PASSWORD=replace_me

# Public URLs for clients and media links.
VITE_API_BASE_URL=
VITE_WS_URL=
MINIO_PUBLIC_ENDPOINT=https://app.example.com
MEDIAMTX_PUBLIC_WEBRTC_URL=https://app.example.com
MEDIAMTX_PUBLIC_HLS_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
