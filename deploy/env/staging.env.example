ENVIRONMENT=staging
COMPOSE_PROJECT_NAME=nagarnetra-staging

# Host-level ports used by nginx upstreams.
WEB_HOST_PORT=18080
API_HOST_PORT=18000
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
OPENSEARCH_HOST_PORT=19200
MEDIAMTX_RTSP_PORT=18554
MEDIAMTX_HLS_PORT=18888
MEDIAMTX_WEBRTC_PORT=18889
MEDIAMTX_API_PORT=19997
SIMULATOR_HOST_PORT=19100

# Bind every service to localhost; only nginx is internet-facing.
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
POSTGRES_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
MINIO_BIND_ADDRESS=127.0.0.1
OPENSEARCH_BIND_ADDRESS=127.0.0.1
MEDIAMTX_BIND_ADDRESS=127.0.0.1
SIMULATOR_BIND_ADDRESS=127.0.0.1

# Production-grade secrets must be unique per environment.
POSTGRES_PASSWORD=replace_me
MINIO_ROOT_USER=replace_me
MINIO_ROOT_PASSWORD=replace_me
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_me
GRAFANA_ADMIN_PASSWORD=replace_me

# Public URLs for clients and media links.
VITE_API_BASE_URL=
VITE_WS_URL=
MINIO_PUBLIC_ENDPOINT=https://staging.example.com
MEDIAMTX_PUBLIC_WEBRTC_URL=https://staging.example.com
MEDIAMTX_PUBLIC_HLS_URL=https://staging.example.com
CORS_ORIGINS=https://staging.example.com
